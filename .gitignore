# ── Binários e artefatos de compilação ───────────────────────────────
bin/
*.o
*.obj
*.exe
*.out

# Binários gerados direto ao lado do fonte (se alguém compilar na mão)
sequencial/04_convolucao
sequencial/04_convolucao_instrumentado
openmp/convolucao_omp
mpi/convolucao_mpi

# ── Material de referência: versiona só os fontes ────────────────────
# Os exemplos da disciplina compilam com o mesmo nome do fonte, sem
# extensão, então a regra ignora tudo e reinclui apenas o código.
referencia/codigos/**/*
!referencia/codigos/**/
!referencia/codigos/**/*.c
!referencia/codigos/**/*.cpp
!referencia/codigos/**/*.h

# ── Python (scripts de gráficos) ─────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/

# ── Editor e sistema operacional ─────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# ── Temporários ──────────────────────────────────────────────────────
*.log
*.tmp
*~

# NÃO ignorar: dados/medicoes/*.csv e graficos/*.png
# Eles são artefatos de entrega e devem ir para o repositório.